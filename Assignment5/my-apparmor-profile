#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected) {
    #include <abstractions/base>
    #include <abstractions/python>

    # Allow Python and its libraries to load and run
    /usr/local/bin/python* ix,
    /usr/local/lib/** mr,
    /usr/lib/** mr,
    /lib/** mr,

    # Allow the app directory
    /app/** rwk,

    # Allow network
    network inet stream,
    network inet dgram,

    # --- Security restrictions (the point of the exercise) ---
    # Block reading sensitive system files
    deny /etc/passwd r,
    deny /etc/shadow r,
    deny /var/** rw,

    # Block executing a shell
    deny /bin/bash rwx,
    deny /bin/sh rwx,

    # Capability restrictions
    capability net_bind_service,
    deny capability sys_admin,
}